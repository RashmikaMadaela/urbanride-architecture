%% UrbanRide resilience layers across the request path
%% Target file: diagrams/resilience-01-layers.png
%% Covers all four named mechanisms - see ADD section 7.

flowchart LR
    client["Rider / Driver<br/>clients"]
    edgeLayer["API Gateway<br/><b>Rate limiter</b><br/>Token bucket + load shedding"]
    mesh["Envoy service mesh<br/><b>Circuit breakers</b><br/>Timeouts + bulkheads"]
    service["Core services<br/>Matching Engine / Trip Management Service / Billing Service"]
    kafka["Kafka buffer<br/><b>Backpressure</b><br/>Consumer lag autoscaling"]
    dlq["Retry policy<br/>Exponential backoff<br/><b>Dead-letter topics</b>"]
    data["Redis + PostgreSQL<br/>Rebuildable index + durable state"]
    fallback["Graceful degradation<br/>Haversine ETA fallback"]

    client -->|"HTTPS / WebSocket"| edgeLayer
    edgeLayer -->|"allowed request"| mesh
    edgeLayer -->|"events / burst buffer"| kafka
    mesh -->|"bounded gRPC"| service
    service -->|"async events"| kafka
    service -->|"bounded data calls"| data
    kafka -->|"after max retries"| dlq
    mesh -->|"upstream timeout"| fallback
    fallback -.->|"reduced match quality"| service

    classDef clientNode fill:#FFF1CC,stroke:#9A6A00,stroke-width:1.5px,color:#1a1a1a
    classDef protection fill:#E2F2E8,stroke:#2E6B43,stroke-width:1.5px,color:#1a1a1a
    classDef core       fill:#DCECF8,stroke:#24557A,stroke-width:1.5px,color:#1a1a1a
    classDef degraded   fill:#FCE8E6,stroke:#A33A32,stroke-width:1.5px,color:#1a1a1a

    class client clientNode
    class edgeLayer,mesh,kafka,data protection
    class service core
    class dlq,fallback degraded
